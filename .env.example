# Copy this file to .env.local and fill in your own values.
# .env.local is never uploaded to GitHub.

# Supabase → Project Settings → API Keys. Safe to expose (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret key (sb_secret_...). Used only on the server, for the daily automatic check.
# Never prefix it with NEXT_PUBLIC_, never paste it anywhere public.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Vercel sends it with the daily check so nobody else can trigger it.
CRON_SECRET=

# Optional: key for the page-reading service (r.jina.ai) used for pages built by JavaScript.
# Works without a key at a lower rate limit.
JINA_API_KEY=

# Used from phase 4 (AI signals). Keep it secret; never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
